# Sao chép thành .env rồi điền giá trị thật (KHÔNG commit file .env)
# Tên miền trỏ về IP của VM. Chưa có tên miền thì dùng <IP>.sslip.io, ví dụ 129.151.10.20.sslip.io
DOMAIN=jkr.example.com
# Tài khoản admin hệ thống (bắt buộc ở production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=doi-mat-khau-manh-o-day

# (Tùy chọn) Webhook nhận yêu cầu "gửi lỗi cho agent sửa" từ trang Danh sách lỗi của admin.
# App POST JSON {text, prompt, bugs[]} tới URL này. Để trống thì admin chỉ dùng được nút "Sao chép prompt".
AGENT_WEBHOOK_URL=
# Token (nếu webhook cần), gửi dạng header "Authorization: Bearer <token>"
AGENT_WEBHOOK_TOKEN=
# Địa chỉ công khai của app, dùng để tạo link ảnh chụp trong nội dung gửi agent (mặc định tự suy ra)
PUBLIC_URL=

# (Tùy chọn) Dịch bản tin tự động bằng Gemini: nhận diện ngôn ngữ gốc rồi dịch ra vi / en / th / zh.
# Cách dễ hơn: Admin hệ thống nhập khoá ngay trong Quản trị > Dịch tự động (khoá được mã hoá khi lưu và được ưu tiên hơn biến này).
# Không có khoá thì bản tin chỉ hiện bản gốc. Khoá chỉ để ở máy chủ, KHÔNG commit.
GEMINI_API_KEY=
# Model Gemini (mặc định gemini-2.5-flash)
GEMINI_MODEL=

# (Tùy chọn) Chuỗi bí mật để mã hoá khoá API lưu trong DB. Bỏ trống thì app tự tạo file data/.secret_key (quyền 600) cạnh DB.
APP_SECRET=
